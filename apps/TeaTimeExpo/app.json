{
  "expo": {
    "name": "Tea Time",
    "slug": "TeaTimeExpo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#222831"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.ricecake.teatime",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#222831"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Tea Time to access your photos so you can set a profile picture."
        }
      ]
    ],
    "extra": {
      "cognitoRegion": "ap-southeast-2",
      "cognitoUserPoolId": "ap-southeast-2_7xMoJ8i4B",
      "cognitoUserPoolClientId": "3k7m534msd10a7cjmlbsc3caf9",
      "locationApiBaseUrl": "https://pugcsdmf47.execute-api.ap-southeast-2.amazonaws.com/Prod",
      "chatApiBaseUrl": "https://pugcsdmf47.execute-api.ap-southeast-2.amazonaws.com/Stage",
      "webSocketBaseUrl": "wss://kv64fohoj8.execute-api.ap-southeast-2.amazonaws.com/Prod",
      "eas": {
        "projectId": "629b6cfc-9175-42e0-a46d-2f69bd637848"
      }
    }
  }
}
